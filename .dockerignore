# Allow only runtime inputs into the build context. Databases and credentials
# remain excluded even when a developer creates them outside ignored folders.
**
!pyproject.toml
!uv.lock
!src/
!src/**
!config/
!config/sources.yaml
!config/filter.yaml
!config/backup.yaml
!config/scheduler.yaml
!config/handoff.yaml
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.sqlite*
**/*.db*
**/*.pem
**/*.key
**/credentials.json
**/token.json
