# Native CLI defaults; Compose fixes these paths inside its isolated container.
# No credentials are required for v0.3. Keep this file free of secrets.
WAAGD_DB=/data/discovery.sqlite3
WAAGD_SOURCES=config/sources.yaml
WAAGD_FILTER=config/filter.yaml
WAAGD_BACKUP_POLICY=config/backup.yaml
WAAGD_SCHEDULER_CONFIG=config/scheduler.yaml
