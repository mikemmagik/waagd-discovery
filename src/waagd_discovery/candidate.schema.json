{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikemmagik/waagd-discovery/schemas/candidates-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidates": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "published_at",
          "description",
          "date_status",
          "first_seen_at",
          "last_seen_at",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096,
            "pattern": "^https?://"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "date_status": {
            "enum": [
              "valid",
              "missing",
              "invalid"
            ]
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "sources": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "url"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64
                },
                "name": {
                  "type": "string",
                  "maxLength": 300
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 4096
                }
              }
            }
          }
        }
      }
    }
  }
}
