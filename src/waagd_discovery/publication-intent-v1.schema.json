{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weareallgonnadie.example/schemas/publication-intent-v1.schema.json",
  "title": "WAAGD PublicationIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "intent_id",
    "origin",
    "authorization",
    "post",
    "candidate_key",
    "delivery_id",
    "decision_revision",
    "verification_status",
    "editorial_status",
    "publisher",
    "published_at_source",
    "risks",
    "evidence_ids",
    "content_hash",
    "publication_policy_version"
  ],
  "properties": {
    "version": { "const": 1 },
    "intent_id": {
      "type": "string",
      "pattern": "^auto:[a-f0-9]{64}:[1-9][0-9]*$",
      "maxLength": 256
    },
    "origin": { "const": "waagd-discovery" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "automatic"],
      "properties": {
        "kind": { "const": "trusted_publication_policy" },
        "automatic": { "const": true }
      }
    },
    "post": {
      "type": "object",
      "description": "CreatePostInput; consumer also applies shared site validation."
    },
    "candidate_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "delivery_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "decision_revision": { "type": "integer", "minimum": 1 },
    "verification_status": { "const": "VERIFIED" },
    "editorial_status": { "const": "READY_FOR_REVIEW" },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 100 },
    "published_at_source": { "type": "string", "format": "date-time" },
    "risks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "severity": { "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publication_policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  }
}
