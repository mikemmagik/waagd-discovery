<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.waagd.staging-autonomous</string>
  <key>ProgramArguments</key><array>
    <string>/absolute/venv/bin/waagd-autonomous</string>
    <string>--state-dir</string><string>/absolute/private/waagd-staging/autonomous</string>
    <string>--timezone</string><string>Asia/Bangkok</string>
    <string>--daily-time</string><string>08:00</string>
    <string>--cycle-timeout-seconds</string><string>15900</string>
    <string>--inner-cycle-timeout-seconds</string><string>15600</string>
    <string>--cycle-command</string><string>/absolute/venv/bin/waagd-staging --config /absolute/private/waagd-staging/waagd-staging.json cycle</string>
    <string>run-due</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/absolute/private/waagd-staging/autonomous/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/absolute/private/waagd-staging/autonomous/launchd.err.log</string>
</dict></plist>
